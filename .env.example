# Application
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8111
APP_DATABASE_URL=sqlite:///./data.db
APP_AUTH_SECRET=replace-with-a-long-random-secret
APP_AUTH_TOKEN_TTL_SEC=86400

# LLM: use ollama or api
LLM_MODE=ollama
LLM_OLLAMA_BASE=http://127.0.0.1:11434
QWEN_DEFAULT_MODEL=qwen2.5:14b
LAYA_ENABLED=false
LAYA_MODEL=convaiinnovations/laya
LAYA_MIN_CONFIDENCE=0.80
LAYA_DEVICE=cpu
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MY_DASHSCOPE_API_KEY=
LLM_TIMEOUT=30

# Milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB=default
MILVUS_TIMEOUT=30

# Hindsight is optional and may point to a remote service.
HINDSIGHT_ENABLED=false
HINDSIGHT_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=main
HINDSIGHT_RECALL_ENABLED=false
HINDSIGHT_TIMEOUT_SEC=5

# Optional web search provider
WEB_QUERY_API_KEY=
WEB_QUERY_ENDPOINT=
WEB_QUERY_API_VERSION=

# Doubao voice services
VOLC_API_KEY=
VOLC_CLUSTER=
VOLC_VOICE=
ASR_WS_URL=wss://openspeech.bytedance.com/api/v2/asr
TTS_WS_URL=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_BITS=16
VOICE_TIMEOUT_SEC=30
